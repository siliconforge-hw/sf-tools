# ============================================================
# sf-project.env — déclaration du projet pour sf-tools
# Lu par le Makefile (include), par bin/lint.sh / bin/check_style.py (norme, préfixe d'IP)
# et par le hook du plugin Claude Code siliconforge. Format : CLE=valeur, sans espaces.
# ============================================================
PROJECT=<projet>
# Identifiant FAMnnn (sf-handbook/registry.md) et catégorie qu'il implique (config/categories.conf)
PROJECT_ID=<IPxxx>
CATEGORY=<categorie>
TOP_MODULE=<top>
# Préfixe des modules du projet (SF-HDL-001 HDL-2.1)
IP_PREFIX=<ip>
# Norme RTL contrôlée par make lint (laisser vide pour ne pas contrôler)
HDL_STANDARD=SF-HDL-001
