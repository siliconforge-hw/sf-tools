# Norme SF-HDL-001 : tabulations (largeur 4), UTF-8, LF
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sv,svh,v,vh,xdc,sdc,tcl}]
indent_style = tab
indent_size = 4
tab_width = 4

[Makefile]
indent_style = tab

[*.{py,json,yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
