# ============================================================
# sf-tools — chemins des outils, valeurs par défaut (environnement de référence)
# Ne pas modifier pour un autre poste : créer ~/.config/sf-tools/config.env
# (`tools/sf/bin/sf_config.sh --init`) et n'y mettre que les lignes qui diffèrent.
# Priorité : variable d'environnement > ~/.config/sf-tools/config.env > ce fichier.
# Format : CLE=valeur, une par ligne, sans guillemets ; ${HOME} et ${CLE} déjà définies sont développés.
# ============================================================

# --- Racines ---
TOOLS_ROOT=${HOME}/tools
OSS_CAD=${TOOLS_ROOT}/oss-cad-suite

# --- Simulation / lint ---
VERILATOR=verilator
IVERILOG=iverilog
GTKWAVE=gtkwave
# Yosys avec le plugin slang (sinon le lint retombe sur `yosys` du PATH, sans SV complet)
YOSYS=${OSS_CAD}/bin/yosys

# --- Python ---
COCOTB_VENV=${TOOLS_ROOT}/venvs/cocotb
PEAKRDL=${TOOLS_ROOT}/venvs/peakrdl/bin/peakrdl

# --- FPGA (AMD/Xilinx) ---
VIVADO=vivado
VITIS_SETTINGS=${TOOLS_ROOT}/Xilinx/Vitis/2024.2/settings64.sh

# --- ASIC ---
LIBRELANE=${TOOLS_ROOT}/librelane
PDK_ROOT=${HOME}/workspace/asic/pdk

# --- Logiciel embarqué ---
ARM_CC=${TOOLS_ROOT}/Xilinx/Vitis/2024.2/gnu/aarch32/lin/gcc-arm-none-eabi/bin/arm-none-eabi-gcc
RISCV_CC=${TOOLS_ROOT}/riscv/bin/riscv32-unknown-elf-gcc
CPPCHECK=cppcheck
CLANG_FORMAT=clang-format
